"""Shared wiring: what the HTTP server (`main.py`) and the job runner (`worker.py`) both build.

There are two composition roots, one for each way the service is started, and both take their
database engine, clock, repositories and job list from here, so a job and an endpoint use the
same repository code. Like `main.py`, this module imports concretes only; put a repository
that both need on `Wiring`, and register the service's jobs in `register_jobs`.
"""

from __future__ import annotations

from dataclasses import dataclass

from sqlalchemy.ext.asyncio import AsyncEngine, AsyncSession, async_sessionmaker

from {{ package }}.adapters.outbound.clock import SystemClock
from {{ package }}.adapters.outbound.db import SqlJobRunStore, create_engine, create_session_factory
from {{ package }}.application.services.job_registry import JobRegistry
from {{ package }}.application.services.run_due_jobs import RunDueJobs
from {{ package }}.settings import Settings


@dataclass(frozen=True)
class Wiring:
    engine: AsyncEngine
    session_factory: async_sessionmaker[AsyncSession]
    clock: SystemClock

    async def dispose(self) -> None:
        await self.engine.dispose()


def build_wiring(settings: Settings) -> Wiring:
    engine = create_engine(settings)
    return Wiring(
        engine=engine,
        session_factory=create_session_factory(engine),
        clock=SystemClock(),
    )


def register_jobs(registry: JobRegistry, wiring: Wiring) -> None:
    """Register this service's scheduled jobs. The template ships none.

    A job is an async function with no arguments; build it from the same repositories the
    endpoints use. The schedule is a five-field cron expression in UTC, and a job runs when
    something fires `python -m app run-due-jobs` after its schedule has come due:

        registry.register("purge-old-messages", "0 0 * * *", purge_service.run)
    """


def build_job_runner(wiring: Wiring) -> RunDueJobs:
    registry = JobRegistry()
    register_jobs(registry, wiring)
    return RunDueJobs(registry, SqlJobRunStore(wiring.session_factory), wiring.clock)
