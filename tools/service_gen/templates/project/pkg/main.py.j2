"""Composition root for the HTTP server: wires services into adapters and creates the ASGI app.

Together with `worker.py` (the job runner) and the shared `wiring.py`, this is where concrete
implementations are chosen. Swap outbound adapters (databases, clients) there, never inside the
domain or application layers.
"""

from __future__ import annotations

import logging
from collections.abc import AsyncIterator
from contextlib import asynccontextmanager
from pathlib import Path
from typing import Any

from connexion import AsyncApp
from connexion.resolver import Resolver

from {{ package }}.adapters.inbound import http_errors
{% for tag in spec.tags %}
from {{ package }}.adapters.inbound.{{ tag.snake }}_adapter import {{ tag.pascal }}RequestAdapter
{% endfor %}
{% if spec.has_health_tag %}
from {{ package }}.adapters.outbound.db import DatabaseProbe
{% endif %}
{% for tag in spec.tags %}
from {{ package }}.application.services.{{ tag.snake }}_service import {{ tag.pascal }}Service
{% endfor %}
from {{ package }}.generated.handlers import Adapters, build_operations
from {{ package }}.settings import Settings
from {{ package }}.wiring import Wiring, build_wiring

SPEC_PATH = Path(__file__).resolve().parent.parent / "openapi" / "openapi.yml"


def build_adapters(settings: Settings, wiring: Wiring) -> Adapters:
    """Construct outbound adapters -> services -> inbound request adapters.

    Repositories take `wiring.session_factory` and are passed into the services they back.
    A repository the job runner needs too belongs on `Wiring` (see `wiring.py`).
    """
{% if spec.has_health_tag %}
    # The layer rules keep ports out of main, so for more probes pass them inline or as a
    # tuple; a `list[ReadinessProbe]` annotation would import the port.
    probes = [DatabaseProbe(wiring.engine)]
{% endif %}
    return Adapters(
{% for tag in spec.tags %}
{% if tag.is_health %}
        {{ tag.snake }}={{ tag.pascal }}RequestAdapter({{ tag.pascal }}Service(probes)),
{% else %}
        {{ tag.snake }}={{ tag.pascal }}RequestAdapter({{ tag.pascal }}Service()),
{% endif %}
{% endfor %}
    )


def create_app(settings: Settings | None = None) -> AsyncApp:
    settings = settings or Settings()
    logging.basicConfig(level=settings.log_level)
    wiring = build_wiring(settings)

    @asynccontextmanager
    async def lifespan(_: Any) -> AsyncIterator[None]:
        yield
        await wiring.dispose()

    operations = build_operations(build_adapters(settings, wiring))
    app = AsyncApp(__name__, lifespan=lifespan)
    app.add_api(
        SPEC_PATH,
        resolver=Resolver(function_resolver=operations.__getitem__),
        pythonic_params=True,
        strict_validation=True,
        validate_responses=settings.validate_responses,
    )
    http_errors.register_error_handlers(app)
    return app


app = create_app()
