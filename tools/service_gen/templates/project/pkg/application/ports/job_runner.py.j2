"""The "run due jobs" entry point the inbound adapters (command line, Lambda) call."""

from __future__ import annotations

from dataclasses import dataclass
from enum import StrEnum
from typing import Protocol


class JobStatus(StrEnum):
    RAN = "ran"
    FAILED = "failed"
    NOT_DUE = "not due"
    RUNNING_ELSEWHERE = "running elsewhere"


@dataclass(frozen=True)
class JobResult:
    name: str
    status: JobStatus
    error: str | None = None


@dataclass(frozen=True)
class RunReport:
    results: tuple[JobResult, ...]

    @property
    def failed(self) -> bool:
        return any(result.status is JobStatus.FAILED for result in self.results)


class JobRunner(Protocol):
    async def run_due_jobs(self) -> RunReport:
        """Run every registered job that is due, and report what happened to each."""
        ...
