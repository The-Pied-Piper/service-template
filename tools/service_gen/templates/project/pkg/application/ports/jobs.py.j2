"""A scheduled job as the application sees it: a name, a schedule and a function to run.

Job adapters (inbound, see `adapters/inbound/cron.py`) build these from what a service declares,
the way request adapters build calls from requests; `JobRegistry` collects them.
"""

from __future__ import annotations

from collections.abc import Awaitable, Callable
from dataclasses import dataclass

from {{ package }}.domain.schedule import Schedule

Task = Callable[[], Awaitable[None]]


@dataclass(frozen=True)
class Job:
    name: str
    schedule: Schedule
    task: Task
