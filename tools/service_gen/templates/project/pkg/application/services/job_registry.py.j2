"""The list of scheduled jobs the runner looks through. The template ships none.

`worker.py` fills it from the job adapters (`build_job_adapters`).
"""

from __future__ import annotations

from {{ package }}.application.ports.jobs import Job
from {{ package }}.domain.errors import DuplicateJobError


class JobRegistry:
    def __init__(self) -> None:
        self._jobs: dict[str, Job] = {}

    def register(self, job: Job) -> None:
        """Add a job. Raises if the name is taken."""
        if job.name in self._jobs:
            raise DuplicateJobError(f"a job named {job.name!r} is already registered")
        self._jobs[job.name] = job

    def jobs(self) -> tuple[Job, ...]:
        return tuple(self._jobs.values())
