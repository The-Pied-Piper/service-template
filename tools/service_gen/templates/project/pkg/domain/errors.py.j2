"""Errors raised by the domain and application layers.

They carry no transport knowledge: the inbound adapter translates them into responses.
"""


class DomainError(Exception):
    """Base class for all business-rule violations."""


class NotFoundError(DomainError):
    pass


class ConflictError(DomainError):
    pass


class ValidationError(DomainError):
    pass


class InvalidScheduleError(ValidationError):
    """A cron expression that cannot be read, or that never fires."""


class DuplicateJobError(ConflictError):
    """Two scheduled jobs were registered under the same name."""
