from datetime import UTC, datetime, timedelta
from uuid import uuid4

import pytest
from sqlalchemy import delete, text

from {{ package }}.adapters.inbound.cron import parse_cron
from {{ package }}.adapters.outbound.db import (
    Base,
    JobRunRow,
    SqlJobRunStore,
    create_engine,
    create_session_factory,
)
