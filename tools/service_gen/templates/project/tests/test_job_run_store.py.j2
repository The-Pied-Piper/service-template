from {{ package }}.application.services.run_due_jobs import RunDueJobs
from {{ package }}.domain.job_run import JobRun
from {{ package }}.settings import Settings

NOW = datetime(2026, 11, 28, 0, 0, 3, tzinfo=UTC)
LONG_AGO = NOW - timedelta(hours=1)


@pytest.fixture
async def store() -> AsyncIterator[SqlJobRunStore]:
    engine = create_engine(Settings())
    try:
        async with engine.begin() as connection:
            await connection.execute(text("SELECT 1"))
            await connection.run_sync(Base.metadata.create_all)
    except OSError:
        await engine.dispose()
        pytest.skip("no database reachable")
    yield SqlJobRunStore(create_session_factory(engine))
    async with engine.begin() as connection:
        await connection.execute(delete(JobRunRow).where(JobRunRow.name.like("test-%")))
    await engine.dispose()


@pytest.fixture
def name() -> str:
    return f"test-{uuid4()}"


async def test_an_unknown_job_has_no_record(store: SqlJobRunStore, name: str) -> None:
    assert await store.get(name) is None


async def test_claim_then_finish_round_trip(store: SqlJobRunStore, name: str) -> None:
    assert await store.claim(name, seen_last_started_at=None, now=NOW, locked_since_before=LONG_AGO)
    assert await store.get(name) == JobRun(name, last_started_at=NOW, running_since=NOW)

    later = NOW + timedelta(seconds=4)
    await store.finish(name, started_at=NOW, finished_at=later, error="boom")

    assert await store.get(name) == JobRun(
        name, last_started_at=NOW, last_finished_at=later, running_since=None, last_error="boom"
    )


async def test_a_nul_character_in_an_error_message_is_dropped(
    store: SqlJobRunStore, name: str
) -> None:
    assert await store.claim(name, seen_last_started_at=None, now=NOW, locked_since_before=LONG_AGO)

    await store.finish(name, started_at=NOW, finished_at=NOW, error="ValueError: a\x00b")

    record = await store.get(name)
    assert record is not None
    assert record.last_error == "ValueError: ab"


async def test_a_claim_on_an_out_of_date_record_loses(store: SqlJobRunStore, name: str) -> None:
    assert await store.claim(name, seen_last_started_at=None, now=NOW, locked_since_before=LONG_AGO)
    await store.finish(name, started_at=NOW, finished_at=NOW, error=None)

    # A runner that read the record before the first claim tries now, after it finished.
    assert not await store.claim(
        name, seen_last_started_at=None, now=NOW, locked_since_before=LONG_AGO
    )


async def test_a_running_job_cannot_be_claimed_until_the_lock_is_stale(
    store: SqlJobRunStore, name: str
) -> None:
    assert await store.claim(name, seen_last_started_at=None, now=NOW, locked_since_before=LONG_AGO)
    day = NOW + timedelta(days=1)

    assert not await store.claim(
        name, seen_last_started_at=NOW, now=day, locked_since_before=NOW - timedelta(hours=1)
    )
    assert await store.claim(
        name, seen_last_started_at=NOW, now=day, locked_since_before=NOW + timedelta(seconds=1)
    )


async def test_a_run_that_outlived_its_lock_cannot_finish_the_next_one(
    store: SqlJobRunStore, name: str
) -> None:
    assert await store.claim(name, seen_last_started_at=None, now=NOW, locked_since_before=LONG_AGO)
    later = NOW + timedelta(hours=2)
    # The first run is taken as crashed; a second run claims the job.
    assert await store.claim(
        name, seen_last_started_at=NOW, now=later, locked_since_before=NOW + timedelta(hours=1)
    )

    # The first run finally finishes: it must leave the second run's lock alone.
    await store.finish(name, started_at=NOW, finished_at=later, error="late")

    assert await store.get(name) == JobRun(name, last_started_at=later, running_since=later)


async def test_of_many_simultaneous_claims_exactly_one_wins(
    store: SqlJobRunStore, name: str
) -> None:
    results = await asyncio.gather(
        *[
            store.claim(name, seen_last_started_at=None, now=NOW, locked_since_before=LONG_AGO)
            for _ in range(8)
        ]
    )

    assert results.count(True) == 1


class FixedClock:
    def __init__(self, now: datetime) -> None:
        self.current = now

    def now(self) -> datetime:
        return self.current


async def test_run_due_jobs_over_postgres(store: SqlJobRunStore, name: str) -> None:
    calls: list[str] = []

    async def task() -> None:
        calls.append(name)

    registry = JobRegistry()
    registry.register(Job(name, parse_cron("0 0 * * *"), task))
    clock = FixedClock(NOW)
    runner = RunDueJobs(registry, store, clock)

    first = await runner.run_due_jobs()
    clock.current = NOW + timedelta(hours=5)
    second = await runner.run_due_jobs()
    clock.current = NOW + timedelta(days=1)
    third = await runner.run_due_jobs()

    assert [r.results[0].status for r in (first, second, third)] == [
        JobStatus.RAN,
        JobStatus.NOT_DUE,
        JobStatus.RAN,
    ]
    assert calls == [name, name]
    record = await store.get(name)
    assert record is not None
    assert record.running_since is None
    assert record.last_error is None
