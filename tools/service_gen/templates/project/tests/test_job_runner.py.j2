"""The job runner's entry points: the command, the Lambda handler and `python -m app`."""

import asyncio
import io
import subprocess
import sys
from pathlib import Path

import pytest

from {{ package }}.adapters.inbound.jobs_cli import run_due_jobs_command
from {{ package }}.adapters.inbound.jobs_lambda import JobsFailedError, run_due_jobs_event
from {{ package }}.adapters.outbound.db import Base, create_engine
from {{ package }}.application.ports.job_runner import JobResult, JobStatus, RunReport
from {{ package }}.settings import Settings
from {{ package }}.worker import handler

ROOT = Path(__file__).resolve().parent.parent


class FakeRunner:
    def __init__(self, *results: JobResult) -> None:
        self._report = RunReport(results)

    async def run_due_jobs(self) -> RunReport:
        return self._report


OK = JobResult("purge", JobStatus.RAN)
IDLE = JobResult("report", JobStatus.NOT_DUE)
BROKEN = JobResult("sync", JobStatus.FAILED, "RuntimeError: no")


async def test_the_command_prints_one_line_per_job_and_exits_0() -> None:
    out = io.StringIO()

    code = await run_due_jobs_command(FakeRunner(OK, IDLE), out)

    assert code == 0
    assert out.getvalue() == "purge: ran\nreport: not due\n"


async def test_the_command_exits_1_when_a_job_failed() -> None:
    out = io.StringIO()

    code = await run_due_jobs_command(FakeRunner(OK, BROKEN), out)

    assert code == 1
    assert "sync: failed: RuntimeError: no" in out.getvalue()


async def test_the_lambda_event_returns_a_summary() -> None:
    assert await run_due_jobs_event(FakeRunner(OK, IDLE)) == {
        "results": ["purge: ran", "report: not due"]
    }


async def test_the_lambda_event_fails_the_invocation_when_a_job_failed() -> None:
    with pytest.raises(JobsFailedError, match=r"sync \(RuntimeError: no\)"):
        await run_due_jobs_event(FakeRunner(OK, BROKEN))


async def _prepare_database() -> bool:
    """Make sure the table exists; False when no database is reachable."""
    engine = create_engine(Settings())
    try:
        async with engine.begin() as connection:
            await connection.run_sync(Base.metadata.create_all)
        return True
    except OSError:
        return False
    finally:
        await engine.dispose()


def test_the_command_line_runs_with_no_jobs_scheduled() -> None:
    if not asyncio.run(_prepare_database()):
        pytest.skip("no database reachable")

    result = subprocess.run(
        [sys.executable, "-m", "{{ package }}", "run-due-jobs"],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )

    assert result.returncode == 0, result.stderr
    assert result.stdout == ""


def test_the_lambda_handler_runs_with_no_jobs_scheduled() -> None:
    if not asyncio.run(_prepare_database()):
        pytest.skip("no database reachable")

    assert handler({}, None) == {"results": []}


def test_the_job_runner_command_does_not_load_the_web_application() -> None:
    code = (
        "import sys; import {{ package }}.__main__, {{ package }}.worker; "
        "banned = {'uvicorn', 'connexion', 'starlette', '{{ package }}.main', "
        "'{{ package }}.generated'}; "
        "loaded = banned & set(sys.modules); "
        "sys.exit(f'loaded {loaded}' if loaded else 0)"
    )
    result = subprocess.run([sys.executable, "-c", code], cwd=ROOT, capture_output=True, text=True)
    assert result.returncode == 0, result.stderr


def test_an_unknown_command_is_refused() -> None:
    result = subprocess.run(
        [sys.executable, "-m", "{{ package }}", "nonsense"], cwd=ROOT, capture_output=True, text=True
    )
    assert result.returncode == 2
